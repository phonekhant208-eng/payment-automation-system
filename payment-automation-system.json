        "mode": "runOnceForEachItem",
        "jsCode": "let rawText = $input.item.json.choices[0].message.content.trim();\n\n// Strip away markdown code block wrappers if the AI accidentally sent them\nif (rawText.startsWith(\"```\")) {\n  rawText = rawText.replace(/^```json\\s*/i, \"\").replace(/```$/, \"\").trim();\n}\n\ntry {\n  const groqData = JSON.parse(rawText);\n  return {\n    status: groqData.status || \"INVALID\",\n    transaction_id: groqData.transaction_id || \"\"\n  };\n} catch (error) {\n  // Fallback if the AI completely failed to format JSON\n  return {\n    status: \"INVALID\",\n    transaction_id: \"\",\n    error_details: \"Failed to parse AI response text: \" + rawText\n  };\n}"
